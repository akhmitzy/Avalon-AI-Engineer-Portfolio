{
  "name": "n8n-nodes-dxreview",
  "version": "0.3.0",
  "description": "n8n community node for DxReview prior-authorization review",
  "scripts": {
    "build": "tsc && cp nodes/DxReview/dxreview.svg dist/nodes/DxReview/",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "SEE LICENSE IN ../../LICENSE",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "n8n-workflow": "^2.16.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist/nodes",
    "dist/credentials"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/DxReviewApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/DxReview/DxReview.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
